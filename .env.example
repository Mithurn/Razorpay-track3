# Postgres (docker-compose maps 5433 -> 5432)
DATABASE_URL=postgres://recovery_app:recovery_dev@localhost:5433/recovery
ADMIN_DATABASE_URL=postgres://recovery:recovery_dev@localhost:5433/recovery

# Redis (docker-compose maps 6380 -> 6379)
REDIS_URL=redis://localhost:6380

# Google AI Studio key (https://aistudio.google.com/apikey). Plain key, no GCP/Vertex.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay TEST MODE credentials (dashboard: Test Mode -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: cap on how long a single agent run may take before the deterministic fallback
AGENT_TIMEOUT_MS=60000

PORT=3000
