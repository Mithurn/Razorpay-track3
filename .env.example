# Postgres (docker-compose maps 5434 -> 5432)
DATABASE_URL=postgres://recovery_app:recovery_dev@localhost:5434/recovery
ADMIN_DATABASE_URL=postgres://recovery:recovery_dev@localhost:5434/recovery

# Redis (docker-compose maps 6381 -> 6379)
REDIS_URL=redis://localhost:6381

# OpenRouter key (https://openrouter.ai/keys). One key, any model, no cloud billing account.
OPENROUTER_API_KEY=
AGENT_MODEL=minimax/minimax-m3:free
# Optional: an AI Studio key to run google/ models directly (first-party thought-signature handling)
GOOGLE_GENERATIVE_AI_API_KEY=

# Razorpay TEST MODE credentials (dashboard: Test Mode -> Settings -> API Keys). Replace these
# placeholders with real test-mode values for anything that actually calls Razorpay; a --mock
# bench run never does, and the config only needs them to be non-empty to parse.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder

# One Razorpay account = one merchant for now. Stamped on every case a payment.failed webhook ingests.
MERCHANT_REF=acme_subscriptions

# Bounds on a single agent run before the deterministic fallback takes over
AGENT_TIMEOUT_MS=60000
AGENT_STEP_BUDGET=6
# Hard ceiling on model spend for the whole server process
AGENT_SESSION_CAP_USD=0.50

PORT=3000
# Bind address for the API server. Defaults to localhost; set 0.0.0.0 only when the
# demo is meant to be reachable from the network (the token gates are then load-bearing).
# HOST=localhost

# Shared secret required on POST /cases/:id/{recover,decision,simulate-capture,stop}, POST
# /stop, POST /resume, and GET /cases/:id/audit/verify. Send it as `Authorization: Bearer
# <value>`. Leaving this unset closes those routes entirely; every other read/stream route
# stays open with no token.
DEMO_ACCESS_TOKEN=dev-secret-change-me
# Same value, exposed to the browser — Vite only ships env vars prefixed VITE_ to client code.
# One local demo, one secret; keep these two in sync by hand.
VITE_DEMO_ACCESS_TOKEN=dev-secret-change-me
